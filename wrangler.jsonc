{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glossaire-du-numerique",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "Glossaire du numérique",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
